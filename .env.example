# Site-wide external destinations. Use full https:// URLs.
# On Vercel, set these before building; redeploy after changing them.
NEXT_PUBLIC_BOOKING_URL=https://cal.com/mihiir/30min
NEXT_PUBLIC_CHAIN_LABS_URL=https://chainlabs.in

# Leave a social URL empty to keep its footer label without a link.
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_REDDIT_URL=

# Public ID from Microsoft Clarity -> Settings -> Setup. No secret is required.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Set to true only on a public production deployment.
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# Prevent unfinished previews from being indexed; set false on launch.
NEXT_PUBLIC_NOINDEX=true

# Review build only: visitors with access can read drafts. This is not authentication.
# Drafts never enter SEO, feeds or LLM outputs.
CONTENT_PREVIEW=true
